<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>The Player, round 3, laptop</title>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&amp;family=Instrument+Serif&amp;display=swap">
<style>
body{margin:0}
button{font:inherit;cursor:pointer}
</style>
</helmet>
<div style="width: 2143px; height: 1299px; position: relative; font-family: 'Instrument Sans', system-ui, sans-serif">
<div aria-hidden="true" style="position: absolute; left: 217.7px; top: 36.6px; width: 1710px; height: 1112px; background: url(/_blob/b905fe5cb318003d430f0453ab005d89) 0 0 / 1710px 1112px no-repeat"></div>
<div aria-hidden="true" style="position: absolute; left: 217.7px; top: 36.6px; width: 1710px; height: 37px; background: rgba(255,255,255,0.28)"></div>
<div aria-hidden="true" style="position: absolute; left: 217.7px; top: 73.6px; width: 1710px; height: 51px; background: url(/_blob/7070072a958fda7202291c4d2ea9bb42) 0 0 / 100% 100%; border-radius: 16px 16px 0 0; font: 500 14px/51px -apple-system, system-ui, sans-serif; color: #3C3C43; text-align: center">pianotrainer.app</div>
<div style="position: absolute; left: 217.7px; top: 124.6px; width: 1710px; height: 904px; position: absolute; overflow: hidden; border-radius: 0 0 16px 16px; box-shadow: 0 20px 60px rgba(0,0,0,0.35); background: #F7F3EE; color: #1A1612">

<sc-if value="{{keys}}" hint-placeholder-val="{{true}}">
<img src="/_blob/663fcd1fa4b3cff6fd4188d8e7f4d8f2" alt="The hands at the keys, seen from the seat" style="position: absolute; left: 0; top: 0; display: block; width: 1710px; height: 288px">
</sc-if>

<main style="position: absolute; left: 0; right: 0; top: {{areaTop}}px; bottom: 0; overflow: hidden">

<sc-if value="{{isSheet}}" hint-placeholder-val="{{true}}">
<sc-if value="{{isPage}}" hint-placeholder-val="{{true}}">
<img src="/_blob/71fcd735643e9e2e84bfdf50906ad2f4" alt="Amazing Grace engraved, the cursor in bar 1" style="position: absolute; left: 0; top: {{sheetTop}}px; display: block; width: 1710px; height: 1063px">
<sc-if value="{{loop}}" hint-placeholder-val="{{false}}">
<div aria-hidden="true" style="position: absolute; left: 150px; top: {{bandTop}}px; width: 380px; height: 200px; box-sizing: border-box; background: rgba(232, 118, 47, 0.10); border-left: 3px solid #E8762F; border-right: 3px solid #E8762F">
<div style="position: absolute; left: -10px; top: 80px; width: 17px; height: 28px; border-radius: 9999px; background: #E8762F"></div>
<div style="position: absolute; right: -10px; top: 80px; width: 17px; height: 28px; border-radius: 9999px; background: #E8762F"></div>
</div>
</sc-if>
</sc-if>
<sc-if value="{{isPano}}" hint-placeholder-val="{{false}}">
<section aria-label="Amazing Grace on one line, at the page's size, scrolled under the playhead" style="position: absolute; left: 0; right: 0; top: {{panoTop}}px; height: 192px; overflow: hidden">
<img src="/_blob/48144d057decb0206ec2be45c92c7917" alt="" style="position: absolute; left: -110px; top: 0; display: block; width: 1796px; height: 192px">
<div aria-hidden="true" style="position: absolute; left: 0; top: 0; width: 79px; height: 192px; background: #F7F3EE url(/_blob/48144d057decb0206ec2be45c92c7917) 0 0 / 1796px 192px no-repeat"></div>
<div aria-hidden="true" style="position: absolute; left: 79px; top: 0; width: 32px; height: 192px; background: linear-gradient(90deg, #F7F3EE, rgba(247, 243, 238, 0))"></div>
<div aria-hidden="true" style="position: absolute; left: 570px; top: 20px; width: 2px; height: 150px; border-radius: 1px; background: #2F6DB0"></div>
</section>
</sc-if>
</sc-if>

<sc-if value="{{isDiagrams}}" hint-placeholder-val="{{false}}">
<section aria-label="Chord diagrams" style="position: absolute; left: 120px; right: 120px; top: {{viewTop}}px; display: flex; flex-direction: column; gap: {{diagGap}}px">
<div style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 16px">
<sc-for list="{{nowNext}}" as="c" hint-placeholder-count="2">
<article style="box-sizing: border-box; padding: 20px 24px; border-radius: 18px; background: #FFFFFF; border: {{c.border}}; display: flex; align-items: center; gap: 24px">
<div style="display: flex; flex-direction: column; gap: 4px; min-width: 96px">
<span style="font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: {{c.labelColor}}">{{c.label}}</span>
<span style="font-family: 'Instrument Serif', Georgia, serif; font-size: {{c.nameSize}}px; line-height: 1">{{c.name}}</span>
<span style="font-size: 14px; color: #6B6259">{{c.notes}}</span>
</div>
<div style="position: relative; width: {{c.kb.width}}px; height: {{c.kb.height}}px; flex: none">
<sc-for list="{{c.kb.whites}}" as="k" hint-placeholder-count="14">
<div style="position: absolute; left: {{k.x}}px; top: 0; width: {{k.w}}px; height: {{k.h}}px; box-sizing: border-box; border: 1px solid #CFC6BA; border-radius: 0 0 4px 4px; background: {{k.fill}}"></div>
</sc-for>
<sc-for list="{{c.kb.blacks}}" as="k" hint-placeholder-count="10">
<div style="position: absolute; left: {{k.x}}px; top: 0; width: {{k.w}}px; height: {{k.h}}px; border-radius: 0 0 3px 3px; background: {{k.fill}}"></div>
</sc-for>
</div>
</article>
</sc-for>
</div>
<p style="margin: 0; font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #6B6259">The chords in this song</p>
<div style="display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px">
<sc-for list="{{allChords}}" as="c" hint-placeholder-count="6">
<button type="button" aria-pressed="{{c.on}}" style="box-sizing: border-box; padding: 14px 12px 12px; border-radius: 14px; background: #FFFFFF; border: {{c.border}}; display: flex; flex-direction: column; align-items: center; gap: 10px; color: #1A1612">
<div style="position: relative; width: {{c.kb.width}}px; height: {{c.kb.height}}px">
<sc-for list="{{c.kb.whites}}" as="k" hint-placeholder-count="14">
<div style="position: absolute; left: {{k.x}}px; top: 0; width: {{k.w}}px; height: {{k.h}}px; box-sizing: border-box; border: 1px solid #CFC6BA; border-radius: 0 0 2px 2px; background: {{k.fill}}"></div>
</sc-for>
<sc-for list="{{c.kb.blacks}}" as="k" hint-placeholder-count="10">
<div style="position: absolute; left: {{k.x}}px; top: 0; width: {{k.w}}px; height: {{k.h}}px; border-radius: 0 0 2px 2px; background: {{k.fill}}"></div>
</sc-for>
</div>
<span style="font-size: 16px; font-weight: 600">{{c.name}}</span>
</button>
</sc-for>
</div>
</section>
</sc-if>

<sc-if value="{{isGrid}}" hint-placeholder-val="{{false}}">
<section aria-label="Chord grid" style="position: absolute; left: 120px; right: 120px; top: {{viewTop}}px; display: flex; flex-direction: column; gap: 10px">
<sc-for list="{{gridRows}}" as="r" hint-placeholder-count="4">
<div style="display: flex; align-items: stretch; gap: 10px">
<span style="width: 64px; flex: none; padding-top: 8px; font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #6B6259">{{r.label}}</span>
<div style="flex: 1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px">
<sc-for list="{{r.bars}}" as="b" hint-placeholder-count="4">
<button type="button" aria-label="Bar {{b.n}}, {{b.chord}}" aria-current="{{b.current}}" onClick="{{b.pick}}" style="height: {{gridH}}px; box-sizing: border-box; padding: 0; border: 2px solid {{b.ring}}; border-radius: 12px; background: {{b.bg}}; color: {{b.fg}}; display: grid; grid-template-columns: 1.4fr 1fr 1fr; position: relative; overflow: hidden">
<span style="position: absolute; left: 10px; top: 6px; font-size: 11px; opacity: 0.6">{{b.n}}</span>
<span style="display: flex; align-items: center; justify-content: center; font-family: 'Instrument Serif', Georgia, serif; font-size: 30px">{{b.chord}}</span>
<span style="display: flex; align-items: center; justify-content: center; border-left: 1px solid {{b.beatLine}}; font-size: 18px; opacity: 0.35">/</span>
<span style="display: flex; align-items: center; justify-content: center; border-left: 1px solid {{b.beatLine}}; font-size: 18px; opacity: 0.35">/</span>
</button>
</sc-for>
</div>
</div>
</sc-for>
</section>
</sc-if>

<sc-if value="{{isLyrics}}" hint-placeholder-val="{{false}}">
<section aria-label="Lyrics and chords" style="position: absolute; left: 0; right: 0; top: {{viewTop}}px; display: flex; flex-direction: column; align-items: center; gap: {{lyricGap}}px">
<p style="margin: 0; font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #6B6259">Verse 1</p>
<sc-for list="{{lyricLines}}" as="l" hint-placeholder-count="4">
<div style="display: flex; align-items: flex-end; gap: 4px; font-size: 30px">
<sc-for list="{{l.bits}}" as="b" hint-placeholder-count="4">
<button type="button" onClick="{{b.pick}}" aria-current="{{b.current}}" style="border: 0; padding: 2px 8px 4px; border-radius: 10px; background: {{b.bg}}; color: #1A1612; display: flex; flex-direction: column; align-items: flex-start; gap: 2px; text-align: left">
<span style="font-size: 17px; font-weight: 700; color: {{b.chordColor}}; min-height: 22px">{{b.chord}}</span>
<span style="font-family: 'Instrument Serif', Georgia, serif; font-size: 34px; line-height: 1.1; white-space: nowrap">{{b.words}}</span>
</button>
</sc-for>
</div>
</sc-for>
</section>
</sc-if>
</main>

<sc-if value="{{showControls}}" hint-placeholder-val="{{true}}">
<button type="button" aria-label="Close" style="position: absolute; left: 16px; top: 16px; width: 44px; height: 44px; border: 1px solid {{glassLine}}; border-radius: 9999px; background: {{glass}}; backdrop-filter: blur(12px); color: {{glassFg}}; display: flex; align-items: center; justify-content: center">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
</button>

<nav aria-label="View" style="position: absolute; left: 50%; top: 16px; transform: translateX(-50%); height: 44px; box-sizing: border-box; padding: 4px; display: flex; gap: 2px; border-radius: 9999px; border: 1px solid {{glassLine}}; background: {{glass}}; backdrop-filter: blur(12px)">
<sc-for list="{{views}}" as="v" hint-placeholder-count="4">
<button type="button" title="{{v.hint}}" aria-pressed="{{v.on}}" onClick="{{v.pick}}" style="height: 34px; padding: 0 14px; border: 0; border-radius: 9999px; background: {{v.bg}}; color: {{v.fg}}; display: flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600">
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{{v.d}}"></path></svg>
<span>{{v.label}}</span>
</button>
</sc-for>
</nav>

<div style="position: absolute; right: 16px; top: 16px; display: flex; gap: 8px">
<button type="button" aria-pressed="{{keys}}" onClick="{{toggleKeys}}" style="height: 44px; padding: 0 14px; border: 1px solid {{glassLine}}; border-radius: 9999px; background: {{keysBg}}; backdrop-filter: blur(12px); color: {{keysFg}}; display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM3 10h18"></path></svg>
<span>{{keysLabel}}</span>
</button>
<button type="button" aria-label="More" aria-expanded="{{isMore}}" onClick="{{openMore}}" style="width: 44px; height: 44px; border: 1px solid {{glassLine}}; border-radius: 9999px; background: {{glass}}; backdrop-filter: blur(12px); color: {{glassFg}}; display: flex; align-items: center; justify-content: center">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M5 12h.01M12 12h.01M19 12h.01"></path></svg>
</button>
</div>

<div style="position: absolute; left: 50%; top: {{capTop}}px; transform: translateX(-50%); height: 68px; box-sizing: border-box; padding: 0 8px; display: flex; align-items: center; gap: 4px; border-radius: 9999px; background: rgba(255, 255, 255, 0.88); backdrop-filter: blur(16px); border: 1px solid #E4DDD3; box-shadow: 0 1px 2px rgba(26,22,18,0.10), 0 12px 32px -8px rgba(26,22,18,0.30)">
<button type="button" aria-expanded="{{isPace}}" onClick="{{openPace}}" style="height: 48px; padding: 0 14px 0 12px; border: 0; border-radius: 9999px; background: transparent; color: #1A1612; display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{{paceIcon}}"></path></svg>
<span>{{paceLabel}}</span>
</button>
<div style="width: 1px; height: 28px; background: #E4DDD3"></div>
<button type="button" aria-label="A step back" onClick="{{stepBack}}" style="width: 48px; height: 48px; border: 0; border-radius: 9999px; background: transparent; color: #1A1612; display: flex; align-items: center; justify-content: center">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
</button>
<button type="button" aria-label="{{playLabel}}" onClick="{{togglePlay}}" style="width: 56px; height: 56px; border: 0; border-radius: 9999px; background: #E8762F; color: #FFFFFF; display: flex; align-items: center; justify-content: center">
<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="{{playIcon}}"></path></svg>
</button>
<button type="button" aria-label="A step forward" onClick="{{stepOn}}" style="width: 48px; height: 48px; border: 0; border-radius: 9999px; background: transparent; color: #1A1612; display: flex; align-items: center; justify-content: center">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
</button>
<div style="width: 1px; height: 28px; background: #E4DDD3"></div>
<button type="button" aria-expanded="{{isHands}}" onClick="{{openHands}}" style="height: 48px; padding: 0 14px 0 12px; border: 0; border-radius: 9999px; background: transparent; color: #1A1612; display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 11V6a2 2 0 0 0-4 0M14 10V4a2 2 0 0 0-4 0v2M10 10.5V6a2 2 0 0 0-4 0v8M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"></path></svg>
<span>{{handsLabel}}</span>
</button>
</div>
</sc-if>

<sc-if value="{{playing}}" hint-placeholder-val="{{false}}">
<button type="button" aria-label="Stop, and show the controls" onClick="{{togglePlay}}" style="position: absolute; inset: 0; border: 0; padding: 0; background: transparent; cursor: pointer; z-index: 40"></button>
</sc-if>

<sc-if value="{{anyOpen}}" hint-placeholder-val="{{false}}">
<button type="button" aria-label="Close the menu" onClick="{{close}}" style="position: absolute; left: 0; top: 0; width: 1710px; height: 904px; border: 0; padding: 0; background: transparent"></button>
</sc-if>

<sc-if value="{{isPace}}" hint-placeholder-val="{{false}}">
<section aria-label="Pace" style="position: absolute; left: 592px; top: {{popTop}}; bottom: {{popBottom}}; width: 300px; box-sizing: border-box; padding: 8px; background: #FFFFFF; border-radius: 16px; box-shadow: 0 2px 4px rgba(26,22,18,0.10), 0 18px 40px -12px rgba(26,22,18,0.30)">
<p style="margin: 8px 12px 4px; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #6B6259">At your own pace</p>
<sc-for list="{{ownPace}}" as="i" hint-placeholder-count="2">
<button type="button" onClick="{{i.pick}}" style="width: 100%; min-height: 52px; padding: 0 12px; border: 0; border-radius: 10px; background: transparent; color: #1A1612; display: flex; align-items: center; gap: 12px; font-size: 15px; text-align: left">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{{i.d}}"></path></svg>
<span style="flex: 1; display: flex; flex-direction: column"><span style="font-weight: 600">{{i.name}}</span><span style="font-size: 13px; color: #6B6259">{{i.line}}</span></span>
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E8762F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="opacity: {{i.checkOp}}"><path d="M20 6 9 17l-5-5"></path></svg>
</button>
</sc-for>
<p style="margin: 12px 12px 4px; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #6B6259">Listen and play along</p>
<sc-for list="{{speeds}}" as="i" hint-placeholder-count="3">
<button type="button" onClick="{{i.pick}}" style="width: 100%; min-height: 44px; padding: 0 12px; border: 0; border-radius: 10px; background: transparent; color: #1A1612; display: flex; align-items: center; gap: 12px; font-size: 15px; text-align: left">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 14 4-4M3.34 19a10 10 0 1 1 17.32 0"></path></svg>
<span style="flex: 1; font-weight: 500">{{i.name}}</span>
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E8762F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="opacity: {{i.checkOp}}"><path d="M20 6 9 17l-5-5"></path></svg>
</button>
</sc-for>
</section>
</sc-if>

<sc-if value="{{isHands}}" hint-placeholder-val="{{false}}">
<section aria-label="Hands" style="position: absolute; left: 880px; top: {{popTop}}; bottom: {{popBottom}}; width: 280px; box-sizing: border-box; padding: 8px; background: #FFFFFF; border-radius: 16px; box-shadow: 0 2px 4px rgba(26,22,18,0.10), 0 18px 40px -12px rgba(26,22,18,0.30)">
<p style="margin: 8px 12px 4px; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #6B6259">Which hands do you play?</p>
<sc-for list="{{handItems}}" as="i" hint-placeholder-count="3">
<button type="button" onClick="{{i.pick}}" style="width: 100%; min-height: 44px; padding: 0 12px; border: 0; border-radius: 10px; background: transparent; color: #1A1612; display: flex; align-items: center; gap: 12px; font-size: 15px; font-weight: 500; text-align: left">
<span style="flex: 1">{{i.name}}</span>
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E8762F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="opacity: {{i.checkOp}}"><path d="M20 6 9 17l-5-5"></path></svg>
</button>
</sc-for>
<div style="height: 1px; margin: 6px 12px; background: #ECE6DD"></div>
<label style="min-height: 44px; padding: 0 12px; display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 15px"><span>Hear the other hand</span><input type="checkbox" checked="{{other}}" onChange="{{toggleOther}}" style="width: 20px; height: 20px; accent-color: #E8762F"></label>
</section>
</sc-if>

<sc-if value="{{isMore}}" hint-placeholder-val="{{false}}">
<section aria-label="More" style="position: absolute; right: 16px; top: 68px; width: 320px; box-sizing: border-box; padding: 16px; display: flex; flex-direction: column; gap: 14px; background: #FFFFFF; border-radius: 16px; box-shadow: 0 2px 4px rgba(26,22,18,0.10), 0 18px 40px -12px rgba(26,22,18,0.30)">
<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; padding: 4px; border-radius: 12px; background: #F2EDE6">
<sc-for list="{{versions}}" as="o" hint-placeholder-count="3">
<button type="button" onClick="{{o.pick}}" style="height: 36px; border: 0; border-radius: 9px; background: {{o.bg}}; color: #1A1612; box-shadow: {{o.shadow}}; font-size: 14px; font-weight: 600">{{o.label}}</button>
</sc-for>
</div>
<div style="display: flex; align-items: center; justify-content: space-between; gap: 12px">
<span style="font-size: 15px">Key</span>
<div style="display: flex; align-items: center; gap: 4px">
<button type="button" aria-label="Down a semitone" onClick="{{keyDown}}" style="width: 36px; height: 36px; border: 1px solid #E4DDD3; border-radius: 9999px; background: #FFFFFF; color: #1A1612; font-size: 18px">−</button>
<span style="min-width: 84px; text-align: center; font-size: 15px; font-weight: 600">{{keyName}}</span>
<button type="button" aria-label="Up a semitone" onClick="{{keyUp}}" style="width: 36px; height: 36px; border: 1px solid #E4DDD3; border-radius: 9999px; background: #FFFFFF; color: #1A1612; font-size: 18px">+</button>
</div>
</div>
<label style="display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 15px"><span>Loop bar {{bar}}</span><input type="checkbox" checked="{{loop}}" onChange="{{toggleLoop}}" style="width: 20px; height: 20px; accent-color: #E8762F"></label>
<label style="display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 15px"><span>Metronome</span><input type="checkbox" checked="{{metro}}" onChange="{{toggleMetro}}" style="width: 20px; height: 20px; accent-color: #E8762F"></label>
<a href="#" style="display: flex; justify-content: space-between; padding-top: 12px; border-top: 1px solid #ECE6DD; color: #1A1612; font-size: 15px; text-decoration: none"><span>All Player settings</span><span aria-hidden="true">›</span></a>
</section>
</sc-if>
</div>
