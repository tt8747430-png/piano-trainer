<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>The Player, round 3, phone</title>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&amp;family=Instrument+Serif&amp;display=swap">
<style>
body{margin:0}
button{font:inherit;cursor:pointer}
</style>
</helmet>
<div style="width: 450px; height: 920px; position: relative; font-family: 'Instrument Sans', system-ui, sans-serif">
<div style="position: absolute; left: 24px; top: 23px; width: 402px; height: 874px; overflow: hidden; border-radius: 62px; background: #F7F3EE; color: #1A1612">

<sc-if value="{{keys}}" hint-placeholder-val="{{true}}">
<div aria-hidden="true" style="position: absolute; left: 0; top: 0; width: 402px; height: 62px; background: #2A1F18"></div>
<img src="/_blob/26111798dc921611eaf5270d25a0fb72" alt="The hands at the keys, seen from the seat" style="position: absolute; left: 0; top: 62px; display: block; width: 402px; height: 198px">
</sc-if>
<div aria-hidden="true" style="position: absolute; left: 0; top: 0; width: 402px; height: 54px; z-index: 5; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; padding: 6px 34px 0 50px; color: {{statusFg}}; font: 600 17px -apple-system, system-ui, sans-serif">
<span>9:41</span>
<span style="display: flex; align-items: center; gap: 6px"><svg width="18" height="12" viewBox="0 0 18 12" fill="currentColor"><rect x="0" y="8" width="3" height="4" rx="1"></rect><rect x="5" y="5.5" width="3" height="6.5" rx="1"></rect><rect x="10" y="3" width="3" height="9" rx="1"></rect><rect x="15" y="0" width="3" height="12" rx="1"></rect></svg><svg width="27" height="13" viewBox="0 0 27 13" fill="none"><rect x="0.5" y="0.5" width="23" height="12" rx="3.5" stroke="currentColor" opacity="0.4"></rect><rect x="2" y="2" width="20" height="9" rx="2" fill="currentColor"></rect><rect x="25" y="4.5" width="1.5" height="4" rx="0.75" fill="currentColor" opacity="0.4"></rect></svg></span>
</div>
<div aria-hidden="true" style="position: absolute; left: 134px; bottom: 8px; width: 134px; height: 5px; border-radius: 9999px; background: #1A1612; z-index: 60"></div>

<main style="position: absolute; left: 0; right: 0; top: {{areaTop}}px; bottom: 0; overflow: hidden">

<sc-if value="{{isSheet}}" hint-placeholder-val="{{true}}">
<sc-if value="{{isPage}}" hint-placeholder-val="{{true}}">
<img src="/_blob/0da01c57ce7fd84031e316231c2cf6d2" alt="Amazing Grace engraved, the cursor in bar 1" style="position: absolute; left: 0; top: {{sheetTop}}px; display: block; width: 402px; height: 777px">
</sc-if>
<sc-if value="{{isPano}}" hint-placeholder-val="{{false}}">
<section aria-label="Amazing Grace on one line, at the page's size, scrolled under the playhead" style="position: absolute; left: 0; right: 0; top: {{panoTop}}px; height: 127px; overflow: hidden">
<img src="/_blob/48144d057decb0206ec2be45c92c7917" alt="" style="position: absolute; left: -300px; top: 0; display: block; width: 1188px; height: 127px">
<div aria-hidden="true" style="position: absolute; left: 0; top: 0; width: 52px; height: 127px; background: #F7F3EE url(/_blob/48144d057decb0206ec2be45c92c7917) 0 0 / 1188px 127px no-repeat"></div>
<div aria-hidden="true" style="position: absolute; left: 52px; top: 0; width: 20px; height: 127px; background: linear-gradient(90deg, #F7F3EE, rgba(247, 243, 238, 0))"></div>
<div aria-hidden="true" style="position: absolute; left: 134px; top: 14px; width: 2px; height: 96px; border-radius: 1px; background: #2F6DB0"></div>
</section>
</sc-if>
</sc-if>

<sc-if value="{{isDiagrams}}" hint-placeholder-val="{{false}}">
<section aria-label="Chord diagrams" style="position: absolute; left: 16px; right: 16px; top: {{viewTop}}px; display: flex; flex-direction: column; gap: 10px">
<sc-for list="{{nowNext}}" as="c" hint-placeholder-count="2">
<article style="box-sizing: border-box; padding: 14px 16px; border-radius: 16px; background: #FFFFFF; border: {{c.border}}; display: flex; align-items: center; justify-content: space-between; gap: 12px">
<div style="display: flex; flex-direction: column; gap: 2px">
<span style="font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: {{c.labelColor}}">{{c.label}}</span>
<span style="font-family: 'Instrument Serif', Georgia, serif; font-size: {{c.nameSize}}px; line-height: 1">{{c.name}}</span>
<span style="font-size: 12px; color: #6B6259">{{c.notes}}</span>
</div>
<div style="position: relative; width: {{c.kb.width}}px; height: {{c.kb.height}}px; flex: none">
<sc-for list="{{c.kb.whites}}" as="k" hint-placeholder-count="14">
<div style="position: absolute; left: {{k.x}}px; top: 0; width: {{k.w}}px; height: {{k.h}}px; box-sizing: border-box; border: 1px solid #CFC6BA; border-radius: 0 0 3px 3px; background: {{k.fill}}"></div>
</sc-for>
<sc-for list="{{c.kb.blacks}}" as="k" hint-placeholder-count="10">
<div style="position: absolute; left: {{k.x}}px; top: 0; width: {{k.w}}px; height: {{k.h}}px; border-radius: 0 0 2px 2px; background: {{k.fill}}"></div>
</sc-for>
</div>
</article>
</sc-for>
<p style="margin: 6px 0 0; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #6B6259">The chords in this song</p>
<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px">
<sc-for list="{{allChords}}" as="c" hint-placeholder-count="6">
<button type="button" aria-pressed="{{c.on}}" style="box-sizing: border-box; padding: 10px 6px 8px; border-radius: 12px; background: #FFFFFF; border: {{c.border}}; display: flex; flex-direction: column; align-items: center; gap: 6px; color: #1A1612">
<div style="position: relative; width: {{c.kb.width}}px; height: {{c.kb.height}}px">
<sc-for list="{{c.kb.whites}}" as="k" hint-placeholder-count="14">
<div style="position: absolute; left: {{k.x}}px; top: 0; width: {{k.w}}px; height: {{k.h}}px; box-sizing: border-box; border: 1px solid #CFC6BA; background: {{k.fill}}"></div>
</sc-for>
<sc-for list="{{c.kb.blacks}}" as="k" hint-placeholder-count="10">
<div style="position: absolute; left: {{k.x}}px; top: 0; width: {{k.w}}px; height: {{k.h}}px; background: {{k.fill}}"></div>
</sc-for>
</div>
<span style="font-size: 14px; font-weight: 600">{{c.name}}</span>
</button>
</sc-for>
</div>
</section>
</sc-if>

<sc-if value="{{isGrid}}" hint-placeholder-val="{{false}}">
<section aria-label="Chord grid" style="position: absolute; left: 16px; right: 16px; top: {{viewTop}}px; display: flex; flex-direction: column; gap: 6px">
<p style="margin: 0 0 2px; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #6B6259">Verse</p>
<div style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px">
<sc-for list="{{bars}}" as="b" hint-placeholder-count="16">
<button type="button" aria-label="Bar {{b.n}}, {{b.chord}}" aria-current="{{b.current}}" onClick="{{b.pick}}" style="height: {{gridH}}px; box-sizing: border-box; padding: 0; border: 2px solid {{b.ring}}; border-radius: 10px; background: {{b.bg}}; color: {{b.fg}}; position: relative; display: flex; align-items: center; justify-content: center">
<span style="position: absolute; left: 7px; top: 4px; font-size: 10px; opacity: 0.6">{{b.n}}</span>
<span style="font-family: 'Instrument Serif', Georgia, serif; font-size: 26px">{{b.chord}}</span>
<span style="position: absolute; left: 8px; right: 8px; bottom: 6px; display: flex; justify-content: space-between; font-size: 10px; opacity: 0.4"><span>1</span><span>2</span><span>3</span></span>
</button>
</sc-for>
</div>
</section>
</sc-if>

<sc-if value="{{isLyrics}}" hint-placeholder-val="{{false}}">
<section aria-label="Lyrics and chords" style="position: absolute; left: 16px; right: 16px; top: {{viewTop}}px; display: flex; flex-direction: column; gap: {{lyricGap}}px">
<p style="margin: 0; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #6B6259">Verse 1</p>
<sc-for list="{{lyricLines}}" as="l" hint-placeholder-count="8">
<div style="display: flex; align-items: flex-end; gap: 2px">
<sc-for list="{{l.bits}}" as="b" hint-placeholder-count="2">
<button type="button" onClick="{{b.pick}}" aria-current="{{b.current}}" style="border: 0; padding: 1px 6px 3px; border-radius: 8px; background: {{b.bg}}; color: #1A1612; display: flex; flex-direction: column; align-items: flex-start; text-align: left">
<span style="font-size: 14px; font-weight: 700; color: {{b.chordColor}}; min-height: 18px">{{b.chord}}</span>
<span style="font-family: 'Instrument Serif', Georgia, serif; font-size: 25px; line-height: 1.1; white-space: nowrap">{{b.words}}</span>
</button>
</sc-for>
</div>
</sc-for>
</section>
</sc-if>
</main>

<sc-if value="{{showControls}}" hint-placeholder-val="{{true}}">
<button type="button" aria-label="Close" style="position: absolute; left: 12px; top: 66px; width: 44px; height: 44px; border: 1px solid {{glassLine}}; border-radius: 9999px; background: {{glass}}; backdrop-filter: blur(12px); color: {{glassFg}}; display: flex; align-items: center; justify-content: center">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
</button>
<nav aria-label="View" style="position: absolute; left: 50%; top: 66px; transform: translateX(-50%); height: 44px; box-sizing: border-box; padding: 3px; display: flex; gap: 1px; border-radius: 9999px; border: 1px solid {{glassLine}}; background: {{glass}}; backdrop-filter: blur(12px)">
<sc-for list="{{views}}" as="v" hint-placeholder-count="4">
<button type="button" aria-label="{{v.label}}" title="{{v.hint}}" aria-pressed="{{v.on}}" onClick="{{v.pick}}" style="width: 40px; height: 36px; border: 0; border-radius: 9999px; background: {{v.bg}}; color: {{v.fg}}; display: flex; align-items: center; justify-content: center">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{{v.d}}"></path></svg>
</button>
</sc-for>
</nav>
<div style="position: absolute; right: 12px; top: 66px; display: flex; gap: 6px">
<button type="button" aria-label="{{keysLabel}}" aria-pressed="{{keys}}" onClick="{{toggleKeys}}" style="width: 44px; height: 44px; border: 1px solid {{glassLine}}; border-radius: 9999px; background: {{keysBg}}; backdrop-filter: blur(12px); color: {{keysFg}}; display: flex; align-items: center; justify-content: center">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM3 10h18"></path></svg>
</button>
<button type="button" aria-label="More" aria-expanded="{{isMore}}" onClick="{{openMore}}" style="width: 44px; height: 44px; border: 1px solid {{glassLine}}; border-radius: 9999px; background: {{glass}}; backdrop-filter: blur(12px); color: {{glassFg}}; display: flex; align-items: center; justify-content: center">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M5 12h.01M12 12h.01M19 12h.01"></path></svg>
</button>
</div>

<div style="position: absolute; left: 50%; top: {{capTop}}px; transform: translateX(-50%); height: 64px; box-sizing: border-box; padding: 0 6px; display: flex; align-items: center; gap: 2px; border-radius: 9999px; background: rgba(255, 255, 255, 0.88); backdrop-filter: blur(16px); border: 1px solid #E4DDD3; box-shadow: 0 1px 2px rgba(26,22,18,0.10), 0 12px 32px -8px rgba(26,22,18,0.30)">
<button type="button" aria-label="Pace: {{paceLabel}}" aria-expanded="{{isPace}}" onClick="{{openPace}}" style="width: 48px; height: 48px; border: 0; border-radius: 9999px; background: transparent; color: #1A1612; display: flex; align-items: center; justify-content: center">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{{paceIcon}}"></path></svg>
</button>
<button type="button" aria-label="A step back" onClick="{{stepBack}}" style="width: 44px; height: 48px; border: 0; border-radius: 9999px; background: transparent; color: #1A1612; display: flex; align-items: center; justify-content: center">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
</button>
<button type="button" aria-label="{{playLabel}}" onClick="{{togglePlay}}" style="width: 52px; height: 52px; border: 0; border-radius: 9999px; background: #E8762F; color: #FFFFFF; display: flex; align-items: center; justify-content: center">
<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="{{playIcon}}"></path></svg>
</button>
<button type="button" aria-label="A step forward" onClick="{{stepOn}}" style="width: 44px; height: 48px; border: 0; border-radius: 9999px; background: transparent; color: #1A1612; display: flex; align-items: center; justify-content: center">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
</button>
<button type="button" aria-label="Hands: {{handsLabel}}" aria-expanded="{{isHands}}" onClick="{{openHands}}" style="width: 48px; height: 48px; border: 0; border-radius: 9999px; background: transparent; color: #1A1612; display: flex; align-items: center; justify-content: center; position: relative">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 11V6a2 2 0 0 0-4 0M14 10V4a2 2 0 0 0-4 0v2M10 10.5V6a2 2 0 0 0-4 0v8M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"></path></svg>
<span style="position: absolute; right: 4px; bottom: 6px; min-width: 16px; height: 16px; padding: 0 3px; box-sizing: border-box; border-radius: 9999px; background: #1A1612; color: #FFFFFF; font-size: 10px; font-weight: 700; line-height: 16px; text-align: center">{{handsShort}}</span>
</button>
</div>
</sc-if>

<sc-if value="{{playing}}" hint-placeholder-val="{{false}}">
<button type="button" aria-label="Stop, and show the controls" onClick="{{togglePlay}}" style="position: absolute; inset: 0; border: 0; padding: 0; background: transparent; cursor: pointer; z-index: 40"></button>
</sc-if>

<sc-if value="{{anyOpen}}" hint-placeholder-val="{{false}}">
<button type="button" aria-label="Close the sheet" onClick="{{close}}" style="position: absolute; left: 0; top: 0; width: 402px; height: 874px; border: 0; padding: 0; background: rgba(26, 22, 18, 0.32)"></button>
</sc-if>

<sc-if value="{{isPace}}" hint-placeholder-val="{{false}}">
<section aria-label="Pace" style="position: absolute; left: 0; right: 0; bottom: 0; box-sizing: border-box; padding: 8px 8px 34px; background: #FFFFFF; border-radius: 20px 20px 0 0; box-shadow: 0 -8px 32px rgba(26,22,18,0.18)">
<div aria-hidden="true" style="width: 36px; height: 5px; margin: 0 auto 6px; border-radius: 9999px; background: #D9D1C6"></div>
<p style="margin: 8px 12px 4px; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #6B6259">At your own pace</p>
<sc-for list="{{ownPace}}" as="i" hint-placeholder-count="2">
<button type="button" onClick="{{i.pick}}" style="width: 100%; min-height: 56px; padding: 0 12px; border: 0; border-radius: 12px; background: transparent; color: #1A1612; display: flex; align-items: center; gap: 12px; font-size: 16px; text-align: left">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="{{i.d}}"></path></svg>
<span style="flex: 1; display: flex; flex-direction: column"><span style="font-weight: 600">{{i.name}}</span><span style="font-size: 13px; color: #6B6259">{{i.line}}</span></span>
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#E8762F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="opacity: {{i.checkOp}}"><path d="M20 6 9 17l-5-5"></path></svg>
</button>
</sc-for>
<p style="margin: 12px 12px 4px; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #6B6259">Listen and play along</p>
<sc-for list="{{speeds}}" as="i" hint-placeholder-count="3">
<button type="button" onClick="{{i.pick}}" style="width: 100%; min-height: 48px; padding: 0 12px; border: 0; border-radius: 12px; background: transparent; color: #1A1612; display: flex; align-items: center; gap: 12px; font-size: 16px; text-align: left">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 14 4-4M3.34 19a10 10 0 1 1 17.32 0"></path></svg>
<span style="flex: 1; font-weight: 500">{{i.name}}</span>
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#E8762F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="opacity: {{i.checkOp}}"><path d="M20 6 9 17l-5-5"></path></svg>
</button>
</sc-for>
</section>
</sc-if>

<sc-if value="{{isHands}}" hint-placeholder-val="{{false}}">
<section aria-label="Hands" style="position: absolute; left: 0; right: 0; bottom: 0; box-sizing: border-box; padding: 8px 8px 34px; background: #FFFFFF; border-radius: 20px 20px 0 0; box-shadow: 0 -8px 32px rgba(26,22,18,0.18)">
<div aria-hidden="true" style="width: 36px; height: 5px; margin: 0 auto 6px; border-radius: 9999px; background: #D9D1C6"></div>
<p style="margin: 8px 12px 4px; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #6B6259">Which hands do you play?</p>
<sc-for list="{{handItems}}" as="i" hint-placeholder-count="3">
<button type="button" onClick="{{i.pick}}" style="width: 100%; min-height: 52px; padding: 0 12px; border: 0; border-radius: 12px; background: transparent; color: #1A1612; display: flex; align-items: center; gap: 12px; font-size: 16px; font-weight: 500; text-align: left">
<span style="flex: 1">{{i.name}}</span>
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#E8762F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="opacity: {{i.checkOp}}"><path d="M20 6 9 17l-5-5"></path></svg>
</button>
</sc-for>
<div style="height: 1px; margin: 6px 12px; background: #ECE6DD"></div>
<label style="min-height: 52px; padding: 0 12px; display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 16px"><span>Hear the other hand</span><input type="checkbox" checked="{{other}}" onChange="{{toggleOther}}" style="width: 22px; height: 22px; accent-color: #E8762F"></label>
</section>
</sc-if>

<sc-if value="{{isMore}}" hint-placeholder-val="{{false}}">
<section aria-label="More" style="position: absolute; left: 0; right: 0; bottom: 0; box-sizing: border-box; padding: 8px 20px 34px; display: flex; flex-direction: column; gap: 16px; background: #FFFFFF; border-radius: 20px 20px 0 0; box-shadow: 0 -8px 32px rgba(26,22,18,0.18)">
<div aria-hidden="true" style="width: 36px; height: 5px; margin: 0 auto; border-radius: 9999px; background: #D9D1C6"></div>
<div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; padding: 4px; border-radius: 12px; background: #F2EDE6">
<sc-for list="{{versions}}" as="o" hint-placeholder-count="3">
<button type="button" onClick="{{o.pick}}" style="height: 40px; border: 0; border-radius: 9px; background: {{o.bg}}; color: #1A1612; box-shadow: {{o.shadow}}; font-size: 15px; font-weight: 600">{{o.label}}</button>
</sc-for>
</div>
<div style="display: flex; align-items: center; justify-content: space-between; gap: 12px">
<span style="font-size: 16px">Key</span>
<div style="display: flex; align-items: center; gap: 4px">
<button type="button" aria-label="Down a semitone" onClick="{{keyDown}}" style="width: 44px; height: 44px; border: 1px solid #E4DDD3; border-radius: 9999px; background: #FFFFFF; color: #1A1612; font-size: 18px">−</button>
<span style="min-width: 84px; text-align: center; font-size: 16px; font-weight: 600">{{keyName}}</span>
<button type="button" aria-label="Up a semitone" onClick="{{keyUp}}" style="width: 44px; height: 44px; border: 1px solid #E4DDD3; border-radius: 9999px; background: #FFFFFF; color: #1A1612; font-size: 18px">+</button>
</div>
</div>
<label style="min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 16px"><span>Loop bar {{bar}}</span><input type="checkbox" checked="{{loop}}" onChange="{{toggleLoop}}" style="width: 22px; height: 22px; accent-color: #E8762F"></label>
<label style="min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 16px"><span>Metronome</span><input type="checkbox" checked="{{metro}}" onChange="{{toggleMetro}}" style="width: 22px; height: 22px; accent-color: #E8762F"></label>
<a href="#" style="min-height: 44px; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #ECE6DD; padding-top: 8px; color: #1A1612; font-size: 16px; text-decoration: none"><span>All Player settings</span><span aria-hidden="true">›</span></a>
</section>
</sc-if>
</div>
<img src="/_blob/352be8f0a6a514527a776f858bf0cb0e" alt="" aria-hidden="true" style="position: absolute; left: 0; top: 0; width: 450px; height: 920px; pointer-events: none; z-index: 100">
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props='{"view":{"editor":"enum","options":["sheet","diagrams","grid","lyrics"],"default":"sheet"},"layout":{"editor":"enum","options":["page","panorama"],"default":"page"},"keys":{"editor":"enum","options":["on","off"],"default":"on"},"open":{"editor":"enum","options":["none","pace","hands","more"],"default":"none"},"playing":{"editor":"enum","options":["no","yes"],"default":"no"},"$preview":{"width":450,"height":920}}'>
class Component extends DCLogic {
renderVals() {
const s = this.state || {};
const p = this.props || {};
const open = s.open !== undefined ? s.open : (p.open ?? 'none');
const playing = s.playing !== undefined ? s.playing : p.playing === 'yes';
const keys = s.keys !== undefined ? s.keys : p.keys !== 'off';
const view = s.view ?? p.view ?? 'sheet';
