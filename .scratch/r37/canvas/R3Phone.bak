const pick = (patch) => () => this.setState(patch);
const flip = (key, first) => () => this.setState({ [key]: !(s[key] ?? first) });
const HOURGLASS = 'M5 22h14M5 2h14M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2';
const WAVES = 'M2 5q2.5 2 5 0t5 0 5 0 5 0M2 12q2.5 2 5 0t5 0 5 0 5 0M2 19q2.5 2 5 0t5 0 5 0 5 0';
const GAUGE = 'm12 14 4-4M3.34 19a10 10 0 1 1 17.32 0';
const mode = s.mode ?? 'wait';
const speed = s.speed ?? 100;
const hands = s.hands ?? 'both';
const bar = s.bar ?? 1;
const loop = s.loop ?? false;
const version = s.version ?? 'original';
const KEYS = ['E♭ major', 'E major', 'F major', 'F♯ major', 'G major', 'A♭ major', 'A major', 'B♭ major', 'B major'];
const key = s.key ?? 4;
const CHORDS = ['G', 'G7', 'C', 'G', 'G', 'G', 'D', 'D7', 'G', 'G7', 'C', 'G', 'Em', 'D', 'G', 'G'];
const WORDS = ['ma-zing', 'grace! How', 'sweet the', 'sound that', 'saved a', 'wretch like', 'me!', 'I', 'once was', 'lost, but', 'now am', 'found, was', 'blind, but', 'now I', 'see.', ''];
const TONES = { G: [7, 11, 14], G7: [7, 11, 14, 17], C: [0, 4, 7], D: [2, 6, 9], D7: [2, 6, 9, 12], Em: [4, 7, 11] };
const NAMES = { G: 'G · B · D', G7: 'G · B · D · F', C: 'C · E · G', D: 'D · F♯ · A', D7: 'D · F♯ · A · C', Em: 'E · G · B' };
const kb = (notes, w, h) => {
const whites = [];
const blacks = [];
let wi = 0;
for (let n = 0; n < 24; n++) {
const on = notes.includes(n);
if ([1, 3, 6, 8, 10].includes(n % 12)) blacks.push({ x: Math.round(wi * w - w * 0.32), w: Math.round(w * 0.64), h: Math.round(h * 0.62), fill: on ? '#E8762F' : '#1A1612' });
else { whites.push({ x: wi * w, w: w + 1, h, fill: on ? '#F6B98F' : '#FFFFFF' }); wi++; }
}
return { whites, blacks, width: wi * w + 1, height: h };
};
const toggleOpen = (name) => () => this.setState({ open: open === name ? 'none' : name });
const chip = (on) => ({ bg: on ? '#FFFFFF' : 'transparent', shadow: on ? '0 1px 2px rgba(26,22,18,0.15)' : 'none' });
const listenName = speed === 100 ? 'Original tempo' : speed + '% speed';
const now = CHORDS[bar - 1];
const next = CHORDS[(bar < 16 ? bar + 1 : 1) - 1];
const dark = keys;
const VIEWS = [
['sheet', 'Sheet', 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M8 13h8M8 17h8'],
['diagrams', 'Diagrams', 'M3 5h18v14H3zM8 5v14M13 5v14M18 5v14M6.5 5v7M11.5 5v7M16 5v7'],
['grid', 'Grid', 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z'],
['lyrics', 'Lyrics', 'M4 6h16M4 12h11M4 18h14'],
];
return {
keys, toggleKeys: () => this.setState({ keys: !keys, open: 'none' }), keysLabel: keys ? 'Hide keys' : 'Show keys',
keysBg: dark ? 'rgba(255, 255, 255, 0.92)' : 'rgba(26, 22, 18, 0.88)', keysFg: dark ? '#1A1612' : '#FFFFFF',
glass: dark ? 'rgba(26, 22, 18, 0.55)' : 'rgba(255, 255, 255, 0.88)', glassFg: dark ? '#FFFFFF' : '#1A1612', glassLine: dark ? 'rgba(255,255,255,0.18)' : '#E4DDD3',
views: VIEWS.map(([id, name, glyph]) => { const on = id === view; const sheet = id === 'sheet'; const pano = layout === 'panorama'; const label = sheet && on ? (pano ? 'Sheet · Panorama' : 'Sheet · Page') : name; const d = sheet && pano ? 'M2 7v10M6 5v14M12 3h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z' : glyph; const hint = sheet && on ? (pano ? 'Show as pages' : 'Show as one line') : 'Show ' + name; return { label, d, hint, on: on ? 'true' : 'false', bg: on ? (dark ? '#FFFFFF' : '#1A1612') : 'transparent', fg: on ? (dark ? '#1A1612' : '#FFFFFF') : (dark ? '#FFFFFF' : '#1A1612'), pick: sheet && on ? pick({ layout: pano ? 'page' : 'panorama' }) : pick({ view: id }) }; }),
isPage: layout === 'page', isPano: layout === 'panorama', panoTop: keys ? 191 : 376,
isSheet: view === 'sheet', isDiagrams: view === 'diagrams', isGrid: view === 'grid', isLyrics: view === 'lyrics',
areaTop: keys ? 260 : 0, statusFg: keys ? '#FFFFFF' : '#1A1612',
sheetTop: keys ? 40 : 116,
viewTop: keys ? 52 : 126, gridH: keys ? 84 : 112, lyricGap: keys ? 4 : 10,
capTop: 770, pauseTop: 776,
nowNext: [
{ label: 'Now · bar ' + bar, name: now, notes: NAMES[now], nameSize: 48, labelColor: '#C2571A', border: '2px solid #E8762F', kb: kb(TONES[now], 15, keys ? 66 : 80) },
{ label: 'Next', name: next, notes: NAMES[next], nameSize: 32, labelColor: '#6B6259', border: '1px solid #E4DDD3', kb: kb(TONES[next], 11, keys ? 44 : 56) },
],
allChords: ['G', 'G7', 'C', 'D', 'D7', 'Em'].map((name) => ({ name, on: name === now ? 'true' : 'false', border: name === now ? '2px solid #1A1612' : '1px solid #E4DDD3', kb: kb(TONES[name], 6, keys ? 26 : 32) })),
bars: CHORDS.map((chord, i) => {
const n = i + 1;
const here = n === bar;
return { n, chord, current: here ? 'true' : 'false', bg: here ? '#1A1612' : '#FFFFFF', fg: here ? '#FFFFFF' : '#1A1612', ring: loop && here ? '#E8762F' : here ? '#1A1612' : '#E4DDD3', pick: pick({ bar: n }) };
}),
lyricLines: [0, 1, 2, 3, 4, 5, 6, 7].map((r) => ({
bits: [0, 1].map((c) => {
const n = r * 2 + c + 1;
const here = n === bar;
return { chord: CHORDS[n - 1], words: (n === 1 ? 'A-' : '') + WORDS[n - 1], current: here ? 'true' : 'false', bg: here ? '#FDEBDD' : 'transparent', chordColor: here ? '#C2571A' : '#1A1612', pick: pick({ bar: n }) };
}),
})),
bar, loop, toggleLoop: flip('loop', false),
stepBack: pick({ bar: Math.max(1, bar - 1) }), stepOn: pick({ bar: Math.min(16, bar + 1) }),
isPace: open === 'pace', isHands: open === 'hands', isMore: open === 'more', anyOpen: open !== 'none',
openPace: toggleOpen('pace'), openHands: toggleOpen('hands'), openMore: toggleOpen('more'), close: pick({ open: 'none' }),
playing, showControls: !playing, playLabel: playing ? 'Pause' : 'Play', playIcon: playing ? 'M7 4h4v16H7zM13 4h4v16h-4z' : 'M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5z', togglePlay: () => this.setState({ playing: !playing, open: 'none' }),
paceIcon: mode === 'wait' ? HOURGLASS : mode === 'follow' ? WAVES : GAUGE,
paceLabel: mode === 'wait' ? 'Wait mode' : mode === 'follow' ? 'Interpret' : listenName,
ownPace: [
{ id: 'wait', name: 'Wait mode', line: 'The music waits for the right notes.', d: HOURGLASS },
{ id: 'follow', name: 'Interpret', line: 'The music follows your tempo.', d: WAVES },
].map((i) => ({ ...i, checkOp: mode === i.id ? 1 : 0, pick: pick({ mode: i.id, open: 'none' }) })),
speeds: [[50, '50% speed'], [75, '75% speed'], [100, 'Original tempo']].map(([v, name]) => ({ name, checkOp: mode === 'listen' && speed === v ? 1 : 0, pick: pick({ mode: 'listen', speed: v, open: 'none' }) })),
handItems: [['rh', 'Right hand'], ['lh', 'Left hand'], ['both', 'Both hands']].map(([id, name]) => ({ name, checkOp: hands === id ? 1 : 0, pick: pick({ hands: id, open: 'none' }) })),
handsLabel: { lh: 'Left hand', both: 'Both hands', rh: 'Right hand' }[hands], handsShort: { lh: 'L', both: '2', rh: 'R' }[hands],
other: s.other ?? true, toggleOther: flip('other', true),
versions: [['original', 'Original'], ['simple', 'Simple'], ['easy', 'Easy']].map(([id, label]) => ({ label, ...chip(id === version), pick: pick({ version: id }) })),
keyName: KEYS[key], keyDown: pick({ key: Math.max(0, key - 1) }), keyUp: pick({ key: Math.min(KEYS.length - 1, key + 1) }),
metro: s.metro ?? false, toggleMetro: flip('metro', false),
