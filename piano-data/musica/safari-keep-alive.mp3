                <div class="content">
                    <div class="container">
                        <div class="row flex__row">
                            <div id="fuldbredde" class="content__right col-9-m col-fuldbredde" style="width: 100%; background-color: transparent;">
                                <article class="default__content item-page fuldbredde" itemscope="" itemtype="https://schema.org/Article">
                                    <div class="fuldbredde" style="text-align:center;">
  <h1 class="page-not-found">Page not found</h1><br /><br /><br />
  <img src="/files/images/main/page-not-found.png" class="not-found-image" alt="Page not found" height="220px"><br /><br /><br />
  <span style="font-size:18px;">Here is a music joke to cheer you up:</span><br /><br />
    <div style="max-width:720px;line-height:1.5em;margin:auto">
      <script>
    var r_text = new Array ();
    r_text[0] = "<i>What do you get when you drop a piano into a mine shaft? A flat minor!</i>";
    r_text[1] = "<i>What concert costs 45 cents? 50 Cent featuring Nickelback!</i>";
    r_text[2] = "<i>Middle C, E-flat and G walk into a bar. Sorry, the barman said. We don't serve minors!</i>";
    r_text[3] = "<i>Why did the pirate buy a Pavarotti album? Because he loved the high Cs!</i>";
    r_text[4] = "<i>What kind of music are balloons afraid of? Pop music!</i>";
    r_text[5] = "<i>Want to hear a joke about a staccato? Never mind, it's too short!</i>";
    r_text[6] = "<i>Want to hear a joke about a fermata? Never mind, it's too long!</i>";
    r_text[7] = "<i>What's the difference between a piano and a fish? You can't tuna fish!</i>";
    r_text[8] = "<i>What do you get when you drop a piano on an army base? A flat major!</i>";
    r_text[9] = "<i>Why don't they know where Mozart is buried? Because he's Haydn!</i>";
    r_text[10] = "<i>Why did Mozart not like chickens? Because they'd all say: Bach, Bach, Bach...!</i>";
    r_text[11] = "<i>Why can't skeletons play music at a church? They have no organs!</i>";
    var i = Math.floor(12*Math.random())
    document.write(r_text[i]);
  </script>
  </div>
  <br /><br />
</div>
<script> 
    var fuldbredde = document.querySelector('.fuldbredde')
    if(fuldbredde) {
	  /* Full width Article fix */
      var contentRightClass = document.querySelector('.content__right')
      contentRightClass.style.width = "100%";
      /* JavaScript Media Queries */
      if (matchMedia) {
          const mq = window.matchMedia("(min-width: 992px)");
          mq.addListener(WidthChange);
          WidthChange(mq);
      }
      // media query change
      function WidthChange(mq) {
          if (mq.matches) {
			contentRightClass.style.backgroundColor = "transparent";
          } else {
			contentRightClass.style.backgroundColor = "#fff";
          }
      }
    }
</script>                                </article>
