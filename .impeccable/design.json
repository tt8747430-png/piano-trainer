  "narrative": {
    "northStar": "The Music Stand",
    "overview": "Everything is designed to be read from a phone propped on a piano's music stand, glanced at between chords with both hands on the keys. The labelled keyboard is the hero: it is on every screen that sounds anything, it plays when tapped, and every key the app sounds goes down on it as it sounds. Around it the screens are calm and native-feeling: a sage ground, white raised surfaces, a mint soft surface for what to do next, and one deep-teal action per screen.",
    "keyCharacteristics": [
      "One keyboard component everywhere: the whole piano, scrolling, one tab stop.",
      "One deep-teal action per screen.",
      "Chord symbols set heavy and large; numerals tabular.",
      "Round 44px icon buttons, pill segmented controls, chips in a scrolling row, a floating glass tab bar.",
      "Bottom sheets of switches and lists, never a sheet over a sheet."
    ],
    "rules": [
      {
        "name": "The Palette Law",
        "body": "Role colours appear on chord tones only; hand colours only in the Player; attention only as the dot of a gap.",
        "section": "colors"
      },
      {
        "name": "The Key Goes Down Rule",
        "body": "A key that sounds goes down, whoever plays it: a plain key turns Key Down mint; a coloured key keeps its colour under a tint, deeper by day and brighter by night.",
        "section": "colors"
      },
      {
        "name": "The Tabular Numbers Rule",
        "body": "Tempo, bar numbers, counts and key labels use tabular figures.",
        "section": "typography"
      },
      {
        "name": "The No Glow Rule",
        "body": "No coloured glow, no gradient, no glassmorphism beyond the tab bar.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do give each screen exactly one deep-teal primary action.",
      "Do show every sound on a keyboard: a key that sounds goes down.",
      "Do label every coloured key with its degree, finger or note.",
      "Do keep targets at 44px and focus rings visible.",
      "Do set numerals that change in place in tabular figures."
    ],
    "donts": [
      "Don't colour chrome with a chord role or a hand colour.",
      "Don't draw a key that does nothing: every key sounds.",
      "Don't stack a sheet over a sheet.",
      "Don't write how-to paragraphs.",
      "Don't use cream, gradients or coloured glow."
    ]
  }
