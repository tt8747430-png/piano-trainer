  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The screen's one action: honey, borderless, the ink on it; the only control filled with a colour.",
      "html": "<button class=\"ds-btn-primary\">Continue</button>",
      "css": ".ds-btn-primary{height:44px;padding:0 16px;border:1px solid transparent;border-radius:12px;background:var(--primary,#EDC684);color:var(--primary-foreground,#332921);font-family:'Onest Variable',system-ui,sans-serif;font-weight:600;font-size:16px;cursor:pointer;transition:filter .2s cubic-bezier(0.22,1,0.36,1),transform .2s cubic-bezier(0.22,1,0.36,1)}.ds-btn-primary:hover{filter:brightness(.95)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:3px solid var(--ring,#356890);outline-offset:2px}"
    },
    {
      "name": "Soft Button",
      "kind": "button",
      "refersTo": "button-soft",
      "description": "A second action beside the honey one: card paper in the 1px control line.",
      "html": "<button class=\"ds-btn-soft\">Arpeggio</button>",
      "css": ".ds-btn-soft{height:44px;padding:0 16px;border:1px solid var(--input,#908479);border-radius:12px;background:var(--card,#FEFDFB);color:var(--foreground,#332921);font-family:'Onest Variable',system-ui,sans-serif;font-weight:600;font-size:16px;cursor:pointer;transition:background .2s cubic-bezier(0.22,1,0.36,1)}.ds-btn-soft:hover{background:var(--muted,#EEE9E2)}.ds-btn-soft:active{transform:translateY(1px)}.ds-btn-soft:focus-visible{outline:3px solid var(--ring,#356890);outline-offset:2px}"
    },
    {
      "name": "Round Button",
      "kind": "button",
      "refersTo": "button-round",
      "description": "A 44px labelled icon button: close, back, settings, MIDI.",
      "html": "<button class=\"ds-btn-round\" aria-label=\"Settings\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1\"/></svg></button>",
      "css": ".ds-btn-round{display:inline-grid;place-items:center;width:44px;height:44px;border:1px solid var(--input,#908479);border-radius:9999px;background:var(--card,#FEFDFB);color:var(--foreground,#332921);cursor:pointer;transition:background .2s cubic-bezier(0.22,1,0.36,1)}.ds-btn-round:hover{background:var(--muted,#EEE9E2)}.ds-btn-round:focus-visible{outline:3px solid var(--ring,#356890);outline-offset:2px}"
    },
    {
      "name": "Chip Row",
      "kind": "chip",
      "refersTo": "chip",
      "description": "One choice of many; the chosen chip is umber, neutral.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\">Triads</button><button class=\"ds-chip\" aria-pressed=\"false\">6th &amp; add</button><button class=\"ds-chip\" aria-pressed=\"false\">7th chords</button></div>",
      "css": ".ds-chips{display:flex;gap:8px;flex-wrap:wrap}.ds-chip{height:44px;padding:0 16px;border:1px solid var(--input,#908479);border-radius:12px;background:var(--card,#FEFDFB);color:var(--foreground,#332921);font-family:'Onest Variable',system-ui,sans-serif;font-weight:600;font-size:16px;cursor:pointer;transition:all .2s cubic-bezier(0.22,1,0.36,1)}.ds-chip:hover{background:var(--muted,#EEE9E2)}.ds-chip[aria-pressed=true]{background:var(--selected,#4B4038);border-color:var(--selected,#4B4038);color:var(--selected-foreground,#FEFDFB)}.ds-chip:focus-visible{outline:3px solid var(--ring,#356890);outline-offset:2px}"
    },
    {
      "name": "Segmented",
      "kind": "chip",
      "refersTo": "segmented-track",
      "description": "One value from a few: a sand track; the chosen segment a card-paper thumb in the control line.",
      "html": "<div class=\"ds-seg\" role=\"group\"><button aria-pressed=\"true\">Root</button><button aria-pressed=\"false\">1st</button><button aria-pressed=\"false\">2nd</button></div>",
      "css": ".ds-seg{display:flex;gap:4px;padding:4px;border-radius:12px;background:var(--muted,#EEE9E2);max-width:320px}.ds-seg button{flex:1;height:44px;border:1px solid transparent;border-radius:11px;background:transparent;color:var(--muted-foreground,#685E56);font-family:'Onest Variable',system-ui,sans-serif;font-weight:600;font-size:16px;cursor:pointer;transition:all .2s cubic-bezier(0.22,1,0.36,1)}.ds-seg button:hover{color:var(--foreground,#332921)}.ds-seg button[aria-pressed=true]{background:var(--card,#FEFDFB);border-color:var(--input,#908479);color:var(--foreground,#332921)}.ds-seg button:focus-visible{outline:3px solid var(--ring,#356890);outline-offset:2px}"
    },
    {
      "name": "Continue Card",
      "kind": "card",
      "refersTo": "continue-band",
      "description": "The one suggestion: a Literata title on a band in its step's wash (a song yellow, a chord step sand, a scale sky), then the honey pill Continue.",
      "html": "<section class=\"ds-continue\"><h2>Triads</h2><div><p>Chords</p><button>Continue</button></div></section>",
      "css": ".ds-continue{max-width:360px;overflow:hidden;border:1px solid var(--border,#DAD1C8);border-radius:14px;background:var(--card,#FEFDFB);color:var(--foreground,#332921)}.ds-continue h2{margin:0;padding:12px 20px;border-bottom:1px solid var(--border,#DAD1C8);background:var(--paint-sand,#F5E0CF);color:var(--foreground,#332921);font-family:'Literata Variable',Georgia,serif;font-weight:600;font-size:28px;line-height:1.2}.ds-continue div{padding:20px;display:flex;flex-direction:column;gap:16px}.ds-continue p{margin:0;font-family:'Onest Variable',system-ui,sans-serif;font-size:17px}.ds-continue button{height:56px;border:0;border-radius:12px;background:var(--primary,#EDC684);color:var(--primary-foreground,#332921);font-family:'Onest Variable',system-ui,sans-serif;font-weight:600;font-size:17px;cursor:pointer}.ds-continue button:hover{filter:brightness(.95)}.ds-continue button:focus-visible{outline:3px solid var(--ring,#356890);outline-offset:2px}"
    },
    {
      "name": "Step Row",
      "kind": "list",
      "refersTo": "step-tile",
      "description": "A step: its kind's wash tile with the deep-shade icon, the title in Onest 600.",
      "html": "<a class=\"ds-step\" href=\"#\"><span class=\"ds-tile\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 18V5l12-2v13\"/><circle cx=\"6\" cy=\"18\" r=\"3\"/><circle cx=\"18\" cy=\"16\" r=\"3\"/></svg></span><span><b>Triads</b><small>Chords</small></span></a>",
      "css": ".ds-step{display:flex;align-items:center;gap:16px;min-height:64px;padding:6px 4px;border-radius:12px;color:var(--foreground,#332921);text-decoration:none;max-width:360px;transition:background .2s cubic-bezier(0.22,1,0.36,1)}.ds-step:hover{background:var(--muted,#EEE9E2)}.ds-tile{display:grid;place-items:center;width:48px;height:48px;border-radius:12px;background:var(--paint-sand,#F5E0CF);color:var(--on-paint-sand,#7D5B40)}.ds-step b{display:block;font:600 17px/1.375 'Onest Variable',system-ui,sans-serif}.ds-step small{display:block;font:400 14px 'Onest Variable',system-ui,sans-serif;color:var(--muted-foreground,#685E56)}.ds-step:focus-visible{outline:3px solid var(--ring,#356890);outline-offset:2px}"
    },
    {
      "name": "Docked Nav",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "The bar docked on phones: monochrome icons and labels, the current place a sand fill with a semibold ink label.",
      "html": "<nav class=\"ds-nav\"><a aria-current=\"page\" href=\"#\">Path</a><a href=\"#\">Songs</a><a href=\"#\">Theory</a></nav>",
      "css": ".ds-nav{display:flex;gap:4px;padding:6px 8px;border-top:1px solid var(--border,#DAD1C8);background:var(--card,#FEFDFB);max-width:390px}.ds-nav a{flex:1;height:56px;display:grid;place-items:center;border-radius:12px;color:var(--muted-foreground,#685E56);text-decoration:none;font-family:'Onest Variable',system-ui,sans-serif;font-weight:500;font-size:14px;transition:color .2s cubic-bezier(0.22,1,0.36,1)}.ds-nav a:hover{color:var(--foreground,#332921)}.ds-nav a[aria-current=page]{background:var(--muted,#EEE9E2);color:var(--foreground,#332921);font-weight:600}.ds-nav a:focus-visible{outline:3px solid var(--ring,#356890);outline-offset:2px}"
    },
    {
      "name": "Keyboard (octave)",
      "kind": "custom",
      "refersTo": "key-white",
      "description": "The signature: paper keys on a light wooden rail; marks pale at rest, full paint when down, a plain key down sky.",
      "html": "<div class=\"ds-kb\"><div class=\"ds-rail\"></div><div class=\"ds-keys\"><span class=\"w root\">1</span><span class=\"w\"></span><span class=\"w third down\">3</span><span class=\"w\"></span><span class=\"w fifth\">5</span><span class=\"w\"></span><span class=\"w\"></span><i style=\"left:9%\"></i><i style=\"left:23%\"></i><i style=\"left:52%\"></i><i style=\"left:66%\"></i><i style=\"left:80%\"></i></div></div>",
      "css": ".ds-kb{width:336px}.ds-rail{height:28px;background:var(--key-rail,#DFD8CF);border-radius:9px 9px 0 0}.ds-keys{position:relative;display:flex;height:150px;background:var(--key-bed,#CBC2B9)}.ds-keys .w{flex:1;display:flex;align-items:flex-end;justify-content:center;padding-bottom:10px;margin-right:1px;border-radius:0 0 9px 9px;background:var(--key-white,#FEFDFB);color:var(--on-key-white,#332921);font:700 14px 'Onest Variable',system-ui,sans-serif;transition:transform 80ms cubic-bezier(0.22,1,0.36,1)}.ds-keys .w:hover{filter:brightness(.95)}.ds-keys .root{background:var(--role-root-wash,#F9DBD3)}.ds-keys .fifth{background:var(--role-5th-wash,#D9EBD5)}.ds-keys .third.down{background:var(--role-3rd,#85B8DC);transform:translateY(2px)}.ds-keys i{position:absolute;top:0;width:8.5%;height:62%;background:var(--key-black,#332C28);border-radius:0 0 6px 6px}"
    }
  ],
  "narrative": {
    "northStar": "The Labelled Picture Book",
    "overview": "The app is drawn as a Busytown cross-section (ADR 0010): the keyboard and the chart are cut open, and every key, chord and control wears its printed name. ADR 0011 reprinted the same book quietly: warm paper for the page and a lighter paper for the cards on it, a soft 1px line round every card and control, and seven paints faded to one even lightness (OKLCH L 0.76 to 0.84, chroma 0.065 to 0.10), so any two sit together and none shouts. Titles and chord symbols are typeset in Literata, a book serif drawn for screens; everything read and every control is Onest. By night the paper turns to dusk and the chrome's paints to dusk tints; the keys keep their paper, a shade softer.\n\nEverything is still read from a phone propped on a piano's music stand, glanced at between chords with both hands on the keys. The labelled keyboard is the hero: it is on every screen that sounds anything, it plays when tapped, and every key the app sounds goes down on it (ADR 0009). Density is low and targets are 44px at least. Colour carries meaning, and so is spent sparingly: honey is the one action, grass is learned, deep sky is a link and focus, ochre is a gap, crimson is wrong; what is chosen or where you are is neutral, and the other paints name places and kinds of step as pale washes.\n\nThe book lends its colour, line and labelling only. Not taken: characters, animals or mascots; a kicker label above a heading; streaks as pressure, upsells, locked content, stock photos; the dark neon piano app and the sage wellness app.",
    "keyCharacteristics": [
      "Grouped surfaces: the page a shade darker than the cards, so a card parts by its surface and a 1px soft line.",
      "One honey action per screen, borderless, with the ink on it: the only control filled with a colour.",
      "What is chosen is neutral: an umber chip, a card-paper segment on a muted track, a muted fill for the current place.",
      "Seven paints at one lightness, each with a pale wash; a key's mark is its wash at rest and its paint when down.",
      "Literata 600 for titles and chord symbols; Onest for reading and every control.",
      "One keyboard component everywhere, the whole piano hung from a light wooden rail."
    ],
    "rules": [
      {
        "name": "The Palette Law",
        "body": "Role colours appear on chord tones only; hand colours only in the Player; the book's paints on the chrome are washes that name a place or a kind of step, never a chord tone. Brick means only the root tone and the right hand: one colour, one meaning.",
        "section": "colors"
      },
      {
        "name": "The Wash And Paint Rule",
        "body": "A mark is its pale wash at rest and its full paint when its key sounds; a plain key down turns sky. Every mark stays while keys go down, and its label stays on it: colour is never the only cue.",
        "section": "colors"
      },
      {
        "name": "The One Honey Rule",
        "body": "Each screen has exactly one honey action, and it is the only control whose fill is a colour. A second action beside it is card paper in the control line (soft), never a second colour.",
        "section": "colors"
      },
      {
        "name": "The Neutral Chosen Rule",
        "body": "What is chosen or where you are is shown in neutrals, never in a paint: a chip fills with umber, a segment or a Theory tab becomes a card-paper thumb in the control line on a sand track, the current place in the nav fills with sand under a semibold ink label.",
        "section": "colors"
      },
      {
        "name": "The Increased Contrast Rule",
        "body": "The quiet default has an answer for the OS's increased-contrast setting: under `prefers-contrast: more` secondary text steps up to umber (night `dusk-ink`), the card line to the control line, the control line to ink (night `dusk-muted`), the hairline to the soft line, the key bed to the control line and a resting mark's wash to 55% of its paint (night 62%). Every calm value ships with its firm one.",
        "section": "colors"
      },
      {
        "name": "The Two Faces Rule",
        "body": "Literata names (titles, chord symbols); Onest reads and operates. A control, a tab or a label on a key is never set in the serif, and a title is never set in the sans.",
        "section": "typography"
      },
      {
        "name": "The Real Weights Rule",
        "body": "Both faces are variable and `font-synthesis-weight` is off: ask Literata for 600 and Onest for what it carries, and never let the browser fake a bold.",
        "section": "typography"
      },
      {
        "name": "The Tabular Numbers Rule",
        "body": "Tempo, bar numbers, counts, key labels and finger numbers are tabular, so a number that changes in place never shifts its neighbours.",
        "section": "typography"
      },
      {
        "name": "The Equal Columns Rule",
        "body": "A chart's lines are grids of equal columns, each line as wide as its bars' share of the longest line, so bars line up down the chart; a bar is parted by a 1px control line and each line closes with one.",
        "section": "layout"
      },
      {
        "name": "The Drawn Not Lifted Rule",
        "body": "A surface separates by its surface and a 1px soft line, never by a shadow or a heavy outline. One exception, on keys only: the keys' material. The rail casts an 8px shade of ink at 7% onto the keys, a white key ends in a 6px lip of ink at 5%, a black key in an 8px slope of white at 12%. They draw a piano and appear nowhere else.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do give each screen exactly one honey action, borderless, with the ink on it.",
      "Do part cards by surface and a 1px soft line, and draw every control in the 1px control line.",
      "Do show what is chosen in neutrals: an umber chip, a card-paper segment, a sand fill for the current place.",
      "Do show every sound on a keyboard: a key that sounds goes down, a mark from its wash to its full paint.",
      "Do label every coloured key with its degree, finger or note.",
      "Do set titles and chord symbols in Literata 600, and everything read or pressed in Onest.",
      "Do give every quiet value an increased-contrast step under `prefers-contrast: more`.",
      "Do keep targets at 44px and focus rings visible (3px, deep sky).",
      "Do set numerals that change in place in tabular figures."
    ],
    "donts": [
      "Don't draw characters, animals or mascots: the book lends its colour, line and labelling only.",
      "Don't put a kicker or eyebrow label above a heading; the heading and the labels on the things themselves are enough.",
      "Don't fill more than one control on a screen with a colour; a second action is soft.",
      "Don't show what is chosen in a paint; brick means only the root tone and the right hand.",
      "Don't colour the navigation; its icons and labels stay soft ink.",
      "Don't colour chrome with a chord role or a hand colour, or put a chrome paint on a chord tone.",
      "Don't put a chrome paint at full strength on the chrome: a place's tint is its wash, with its deep shade on it.",
      "Don't set a control, a tab or a key label in the serif.",
      "Don't draw a 2px line round a card or control, or lift a surface with a shadow (only popovers, the update banner and the slider thumb float).",
      "Don't draw a key that does nothing: every key sounds.",
      "Don't stack a sheet over a sheet; open a list as a page of the sheet.",
      "Don't write how-to paragraphs; the labelled keyboard and the layout teach."
    ]
  }
}
