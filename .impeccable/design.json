      "html": "<nav class=\"ds-nav\"><a aria-current=\"page\" href=\"#\">Path</a><a href=\"#\">Songs</a><a href=\"#\">Theory</a></nav>",
      "css": ".ds-nav{display:flex;gap:4px;padding:6px 8px;border-top:2px solid var(--border,#6D4D37);background:var(--card,#FFFCF7);max-width:390px}.ds-nav a{flex:1;height:56px;display:grid;place-items:center;border-radius:12px;color:var(--foreground,#3F2816);text-decoration:none;font-family:'Balsamiq Sans',system-ui,sans-serif;font-weight:700;font-size:16px;transition:background .2s cubic-bezier(0.22,1,0.36,1)}.ds-nav a:hover{background:var(--muted,#F3EADB)}.ds-nav a[aria-current=page]{background:var(--selected,#B94834);color:var(--selected-foreground,#FFFFFF)}.ds-nav a:focus-visible{outline:3px solid var(--ring,#0F68A2);outline-offset:2px}"
