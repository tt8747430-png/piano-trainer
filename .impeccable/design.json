  "narrative": {
    "northStar": "A labelled picture book of the piano, printed quietly",
    "overview": "The keyboard and the music are cut open, and every key, chord and control wears its printed name. Warm paper for the\npage, a lighter paper for the cards on it, a soft 1px line round every card and control, and seven paints faded to one\neven lightness so any two sit together. Titles and chord symbols are set in a book serif; everything read and every\ncontrol is in a sans.\n\nThe app is read from a phone on a music stand, glanced at between chords with both hands on the keys, and written in\non a laptop. The labelled keyboard is the hero: on every screen that sounds anything it plays when touched, and every\nkey the app sounds goes down on it. Density is low, targets are 44px, and colour carries meaning, so it is spent\nsparingly. These screens are Operate surfaces (lessons and How to use are Read): precision and restraint, patterns the\nlearner already knows.\n\nNot this: mascots, kicker labels over headings, the dark neon piano app.",
    "keyCharacteristics": [
      "Two papers and a 1px line do the work a shadow does elsewhere.",
      "One honey control per screen; the chosen is neutral.",
      "Every paint means one thing, by where it appears.",
      "A book serif for names, a sans for reading and acting.",
      "Floating things float, and nothing jumps."
    ],
    "rules": [
      {
        "name": "The One Honey Rule",
        "body": "Each screen has exactly one honey control, borderless, ink on it. A second action beside it is soft: card paper in the control line.",
        "section": "colors"
      },
      {
        "name": "The Neutral Choice Rule",
        "body": "What is chosen wears the chosen fill or an umber check, never a paint, so colour keeps meaning something. The navigation is monochrome for the same reason.",
        "section": "colors"
      },
      {
        "name": "The Palette Law",
        "body": "Role colours sit on chord tones, hand colours in the Player, chrome paints as washes naming a place or a kind. Brick means the root and the right hand, nothing else.",
        "section": "colors"
      },
      {
        "name": "The Second Cue Rule",
        "body": "Colour is never the only cue: a coloured key always shows its degree, finger or note.",
        "section": "colors"
      },
      {
        "name": "The Serif Names Rule",
        "body": "Literata at 600 sets every `h1`–`h3` and every chord symbol. It never sets a control, a tab or a key label.",
        "section": "typography"
      },
      {
        "name": "The Printed Chord Rule",
        "body": "A chord on screen is printed (`C♯m7`). What is stored, typed or put in a URL stays ASCII.",
        "section": "typography"
      },
      {
        "name": "The Still Numbers Rule",
        "body": "Numbers that change in place (tempo, counts, bars, fingers, times) are tabular. Neither face fakes a bold.",
        "section": "typography"
      },
      {
        "name": "The Floating Rule",
        "body": "The transport, the floating actions and the zoom buttons take no layout room; the page gets scroll room under them, and over music they step aside while it is read.",
        "section": "layout"
      },
      {
        "name": "The Still Screen Rule",
        "body": "Nothing jumps. Controls hold their place between the Player and the editor and on entering Select; what floats is measured before first paint; a score being engraved keeps its old drawing until the new one is whole.",
        "section": "layout"
      },
      {
        "name": "The Piano Exception Rule",
        "body": "The rail's 8px shade, a white key's lip and a black key's slope draw a piano and appear nowhere else.",
        "section": "elevation"
      },
      {
        "name": "The Whole Card Rule",
        "body": "Rows inside a rounded card keep its corners; nothing square pokes out.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do give each screen one honey control and show the chosen in neutrals.",
      "Do part cards by surface and a 1px line.",
      "Do label every coloured key, and give every quiet value a firm one under `prefers-contrast: more`.",
      "Do set titles and chord symbols in Literata 600 and everything else in Onest.",
      "Do keep targets at 44px and focus visible, with a shared component for every kind of thing."
    ],
    "donts": [
      "Don't fill a second control with colour, or show the chosen in a paint.",
      "Don't colour the navigation, or put a chord role or hand colour on the chrome.",
      "Don't set a control in the serif.",
      "Don't draw a 2px line round a card or lift a card with a shadow.",
      "Don't draw a key that does nothing, stack a sheet on a sheet, or write how-to paragraphs.",
      "Don't hang anything under a screen's bar, or cut a title that two lines could hold."
    ]
  }
}
