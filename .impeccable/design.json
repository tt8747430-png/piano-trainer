      "kind": "chip",
      "refersTo": "chip",
      "description": "One choice of many; the chosen chip is brick deep.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\">Triads</button><button class=\"ds-chip\" aria-pressed=\"false\">6th &amp; add</button><button class=\"ds-chip\" aria-pressed=\"false\">7th chords</button></div>",
      "css": ".ds-chips{display:flex;gap:8px;flex-wrap:wrap}.ds-chip{height:44px;padding:0 16px;border:2px solid var(--border,#6D4D37);border-radius:12px;background:var(--card,#FFFCF7);color:var(--foreground,#3F2816);font-family:'Onest Variable',system-ui,sans-serif;font-weight:600;font-size:16px;cursor:pointer;transition:all .2s cubic-bezier(0.22,1,0.36,1)}.ds-chip:hover{background:var(--muted,#F3EADB)}.ds-chip[aria-pressed=true]{background:var(--selected,#B94834);border-color:var(--selected,#B94834);color:var(--selected-foreground,#FFFFFF)}.ds-chip:focus-visible{outline:3px solid var(--ring,#0F68A2);outline-offset:2px}"
    },
