  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The screen's one action: yellow, drawn in the brown line, lettered in Balsamiq.",
      "html": "<button class=\"ds-btn-primary\">Continue</button>",
      "css": ".ds-btn-primary{height:44px;padding:0 16px;border:2px solid var(--border,#6D4D37);border-radius:12px;background:var(--primary,#EEB737);color:var(--primary-foreground,#3F2816);font-family:'Balsamiq Sans','Onest Variable',system-ui,sans-serif;font-weight:700;font-size:17px;cursor:pointer;transition:filter .2s cubic-bezier(0.22,1,0.36,1),transform .2s cubic-bezier(0.22,1,0.36,1)}.ds-btn-primary:hover{filter:brightness(.95)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:3px solid var(--ring,#0F68A2);outline-offset:2px}"
    },
