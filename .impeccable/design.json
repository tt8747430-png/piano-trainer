      "css": ".ds-seg{display:flex;gap:4px;padding:4px;border:2px solid var(--border,#6D4D37);border-radius:12px;background:var(--card,#FFFCF7);max-width:320px}.ds-seg button{flex:1;height:44px;border:0;border-radius:9px;background:transparent;color:var(--muted-foreground,#735F4F);font-family:'Balsamiq Sans','Onest Variable',system-ui,sans-serif;font-weight:700;font-size:16px;cursor:pointer;transition:all .2s cubic-bezier(0.22,1,0.36,1)}.ds-seg button:hover{color:var(--foreground,#3F2816)}.ds-seg button[aria-pressed=true]{background:var(--selected,#B94834);color:var(--selected-foreground,#FFFFFF)}.ds-seg button:focus-visible{outline:3px solid var(--ring,#0F68A2);outline-offset:2px}"
    },
    {
