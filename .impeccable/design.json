      "html": "<section class=\"ds-continue\"><h2>Triads</h2><div><p>Chords</p><button>Continue</button></div></section>",
      "css": ".ds-continue{max-width:360px;overflow:hidden;border:2px solid var(--border,#6D4D37);border-radius:14px;background:var(--card,#FFFCF7);color:var(--foreground,#3F2816)}.ds-continue h2{margin:0;padding:12px 20px;border-bottom:2px solid var(--border,#6D4D37);background:var(--paint-sky,#5FA5DE);color:var(--on-paint,#3F2816);font-family:'Balsamiq Sans',system-ui,sans-serif;font-weight:700;font-size:30px}.ds-continue div{padding:20px;display:flex;flex-direction:column;gap:16px}.ds-continue p{margin:0;font-family:'Onest Variable',system-ui,sans-serif;font-size:17px}.ds-continue button{height:56px;border:2px solid var(--border,#6D4D37);border-radius:12px;background:var(--primary,#EEB737);color:var(--primary-foreground,#3F2816);font-family:'Balsamiq Sans',system-ui,sans-serif;font-weight:700;font-size:22px;cursor:pointer}.ds-continue button:hover{filter:brightness(.95)}.ds-continue button:focus-visible{outline:3px solid var(--ring,#0F68A2);outline-offset:2px}"
    },
    {
