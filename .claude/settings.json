{
  "permissions": {
    "allow": [
      "mcp__Supabase",
      "mcp__Supabase__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/read-instructions.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "understand-anything@understand-anything": false,
    "superpowers@anthropic-plugin-directory": false
  }
}
