{
  "permissions": {
    "allow": [
      "mcp__Supabase",
      "mcp__Supabase__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/reread-after-compact.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "understand-anything@understand-anything": false,
    "superpowers@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      },
      "autoUpdate": true
    }
  }
}
