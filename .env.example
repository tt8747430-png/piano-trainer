# The Supabase project the app talks to (ADR 0116). Copy this file to .env.local and fill in the values from
# the project's settings (API → Project URL, and its publishable key); on Vercel, set the same names in the
# project's environment variables. Never commit the filled-in file.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
